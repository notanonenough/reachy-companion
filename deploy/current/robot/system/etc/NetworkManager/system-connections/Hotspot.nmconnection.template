[connection]
id=Hotspot
uuid=84ea79c9-bbff-494d-ad71-cb2528cc96c5
type=wifi
autoconnect=false
interface-name=wlan0

[wifi]
mode=ap
ssid=reachy-mini-ap

[wifi-security]
group=ccmp;
key-mgmt=wpa-psk
pairwise=ccmp;
proto=rsn;
psk=@@SECRET_WIFI_REACHY_MINI_AP_PSK@@

[ipv4]
method=shared

[ipv6]
addr-gen-mode=default
method=ignore

[proxy]
