[Unit]
Description=Reachy Mini AP Launcher Service
After=network.target

[Service]
Type=simple
ExecStart=@@ROOT@@/u96-safe-launcher.sh
Restart=on-failure
User=pollen
WorkingDirectory=/venvs/mini_daemon/lib/python3.12/site-packages/reachy_mini/daemon/app/services/wireless
TimeoutStopSec=15
Environment="REACHY_U96_SAFE_START_DISABLED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

[Install]
WantedBy=multi-user.target
