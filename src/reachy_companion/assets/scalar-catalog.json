{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Capability": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capability"
        },
        "protocol": {
          "const": 1
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "module": {
          "enum": [
            "permissions",
            "motion",
            "playback",
            "audio_capture",
            "video",
            "metrics"
          ]
        },
        "direction": {
          "enum": [
            "source",
            "executor"
          ]
        },
        "semantic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "object",
          "properties": {
            "major": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "min_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "major",
            "minor",
            "min_minor"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "period_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            {
              "type": "null"
            }
          ]
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "availability": {
          "enum": [
            "available",
            "unknown",
            "disabled",
            "offline"
          ]
        },
        "required_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "protocol",
        "catalog_generation",
        "id",
        "source_boot_id",
        "module",
        "direction",
        "semantic",
        "version",
        "description",
        "unit",
        "range",
        "period_ms",
        "ttl_ms",
        "availability",
        "required_for",
        "operations",
        "coordinate_frame"
      ],
      "additionalProperties": false
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "catalog"
        },
        "protocol": {
          "const": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/Capability"
          }
        }
      },
      "required": [
        "kind",
        "protocol",
        "connection_id",
        "catalog_generation",
        "source_boot_id",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "observation"
        },
        "protocol": {
          "const": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sample_mono_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "time_basis": {
          "enum": [
            "sample",
            "source_receipt",
            "unknown"
          ]
        },
        "age_at_send_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            },
            {
              "type": "null"
            }
          ]
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "availability": {
          "enum": [
            "available",
            "unknown",
            "disabled",
            "offline"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": [
                "number",
                "boolean"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "protocol",
        "connection_id",
        "catalog_generation",
        "capability_id",
        "source_boot_id",
        "sequence",
        "challenge_id",
        "sample_mono_ms",
        "time_basis",
        "age_at_send_ms",
        "ttl_ms",
        "availability",
        "value",
        "confidence",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    }
  }
}
