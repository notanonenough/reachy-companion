{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachy-companion:robot-hub-design:1",
  "$defs": {
    "Capability": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "capability"
        },
        "protocol": {
          "const": 1
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "module": {
          "enum": [
            "permissions",
            "motion",
            "playback",
            "audio_capture",
            "video",
            "metrics"
          ]
        },
        "direction": {
          "enum": [
            "source",
            "executor"
          ]
        },
        "semantic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "object",
          "properties": {
            "major": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "min_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "major",
            "minor",
            "min_minor"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "period_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            {
              "type": "null"
            }
          ]
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "availability": {
          "enum": [
            "available",
            "unknown",
            "disabled",
            "offline"
          ]
        },
        "required_for": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "protocol",
        "catalog_generation",
        "id",
        "source_boot_id",
        "module",
        "direction",
        "semantic",
        "version",
        "description",
        "unit",
        "range",
        "period_ms",
        "ttl_ms",
        "availability",
        "required_for",
        "operations",
        "coordinate_frame"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "observation"
        },
        "protocol": {
          "const": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sample_mono_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "time_basis": {
          "enum": [
            "sample",
            "source_receipt",
            "unknown"
          ]
        },
        "age_at_send_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            },
            {
              "type": "null"
            }
          ]
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "availability": {
          "enum": [
            "available",
            "unknown",
            "disabled",
            "offline"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": [
                "number",
                "boolean"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "protocol",
        "connection_id",
        "catalog_generation",
        "capability_id",
        "source_boot_id",
        "sequence",
        "challenge_id",
        "sample_mono_ms",
        "time_basis",
        "age_at_send_ms",
        "ttl_ms",
        "availability",
        "value",
        "confidence",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "Command": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "command"
        },
        "protocol": {
          "const": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authority": {
          "type": "object",
          "properties": {
            "hub_boot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "compute_boot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "robot_boot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operator_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "microphone_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "interaction_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "speech_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "hub_boot_id",
            "compute_boot_id",
            "robot_boot_id",
            "operator_epoch",
            "microphone_epoch",
            "interaction_epoch",
            "speech_epoch"
          ],
          "additionalProperties": false
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "arguments": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "permit_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "permit_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "challenge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "age_at_send_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [
        "kind",
        "protocol",
        "connection_id",
        "command_id",
        "capability_id",
        "catalog_generation",
        "authority",
        "generation",
        "operation",
        "arguments",
        "permit_id",
        "permit_epoch",
        "challenge_id",
        "age_at_send_ms",
        "ttl_ms"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "result"
        },
        "protocol": {
          "const": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority": {
          "type": "object",
          "properties": {
            "hub_boot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "compute_boot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "robot_boot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operator_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "microphone_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "interaction_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "speech_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "hub_boot_id",
            "compute_boot_id",
            "robot_boot_id",
            "operator_epoch",
            "microphone_epoch",
            "interaction_epoch",
            "speech_epoch"
          ],
          "additionalProperties": false
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "running",
            "completed",
            "cancelled",
            "rejected",
            "unknown"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_verified": {
          "type": "boolean"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "protocol",
        "command_id",
        "authority",
        "generation",
        "status",
        "reason",
        "physical_verified",
        "evidence_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "physical_verified": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "cancelled"
                ]
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "catalog"
        },
        "protocol": {
          "const": 1
        },
        "connection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "catalog_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Capability"
          }
        }
      },
      "required": [
        "kind",
        "protocol",
        "connection_id",
        "catalog_generation",
        "source_boot_id",
        "capabilities"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Capability"
    },
    {
      "$ref": "#/$defs/Observation"
    },
    {
      "$ref": "#/$defs/Command"
    },
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/Catalog"
    }
  ]
}
